# =====================================================================
# EspritTECH & RDI - environment variables
# Copy this file to ".env" for local development and fill in real values.
# The real .env file must never be committed.
# =====================================================================

# --- JWT ---
# HS256 requires at least 32 UTF-8 bytes. Use a secure random value in real environments.
JWT_SECRET=change-this-to-a-secure-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=86400000

# --- Database (MySQL) ---
DB_URL=jdbc:mysql://localhost:3306/esprittech?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=secret

# --- Server ---
SERVER_PORT=8080

# --- CORS (Angular frontend) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Default admin account ---
ADMIN_EMAIL=admin@esprittech.tn
ADMIN_PASSWORD=Admin@1234
