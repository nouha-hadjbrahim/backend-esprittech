# =====================================================================
# EspritTECH & RDI — variables d'environnement
# Copiez ce fichier en ".env" et renseignez vos valeurs réelles.
# Le .env NE DOIT PAS être committé (voir .gitignore).
# TOUTES les variables sont obligatoires — l'appli ne démarre pas sans.
# =====================================================================

# --- JWT ---
# IMPORTANT : 256 bits minimum (>= 32 caractères ASCII) pour HS256.
JWT_SECRET=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# --- Database (MySQL) ---
DB_URL=jdbc:mysql://localhost:3306/esprittech?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=
DB_PASSWORD=

# --- Server ---
SERVER_PORT=8080

# --- CORS (Angular frontend) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Cookies d'authentification (JWT en HttpOnly) ---
# Optionnel (valeurs par défaut : false / Strict).
# Mettre AUTH_COOKIE_SECURE=true en production (HTTPS obligatoire).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Strict

# --- Compte admin par défaut (créé au démarrage s'il n'existe pas) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Azure Entra ID / Microsoft Graph ---
# Vérification du rôle (enseignant/étudiant) à l'inscription via l'appartenance
# aux groupes Azure. Application enregistrée sur portal.azure.com (client credentials).
# Permissions Graph requises (application) : User.Read.All (+ GroupMember.Read.All).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# IDs des groupes Azure (valeurs ESPRIT par défaut ci-dessous).
AZURE_ENSEIGNANT_GROUP_ID=b7172758-d6ff-4b27-99a0-c678735397c4
AZURE_ETUDIANT_GROUP_ID=bbae5c58-1939-4ce8-bf02-caa847052e31
# Boîte ESPRIT expéditrice des emails de vérification (Mail.Send). Ex: noreply@esprit.tn
AZURE_MAIL_SENDER=
